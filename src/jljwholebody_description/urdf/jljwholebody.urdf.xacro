  </joint>

  <xacro:mesh_link
    name="left_ankle_pitch_link"
    mesh="left_ankle_pitch_link.STL"
    mass="0.0365367"
    com_xyz="-0.0000001 0.0257 0.0000001"
    ixx="0.0000058"
    ixy="0"
    ixz="-0.0000001"
    iyy="0.0000043"
    iyz="0"
    izz="0.0000088"/>
  <joint name="left_ankle_pitch" type="revolute">
    <parent link="left_knee_link"/>
    <child link="left_ankle_pitch_link"/>
    <origin xyz="0.007722 -0.0037 -0.42591" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.5" upper="0.3" effort="80.0" velocity="4.0"/>
  </joint>

  <xacro:mesh_link
    name="left_ankle_roll_link"
    mesh="left_ankle_roll_link.STL"
    mass="0.6753837"
    com_xyz="-0.0114404 0.0000497 -0.0253569"
    ixx="0.0002449"
    ixy="0.0000064"
    ixz="-0.0000551"
    iyy="0.002171"
    iyz="0.0000002"
    izz="0.0023523"/>
  <joint name="left_ankle_roll" type="revolute">
    <parent link="left_ankle_pitch_link"/>
    <child link="left_ankle_roll_link"/>
    <origin xyz="0.023992 0.0257 0.0006035" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.2" upper="0.2" effort="80.0" velocity="4.0"/>
  </joint>

  <xacro:mesh_link
    name="right_hip_pitch_link"
    mesh="right_hip_pitch_link.STL"
    mass="2.0699965"
    com_xyz="0.003577 -0.0589637 -0.0587112"
    ixx="0.0036971"
    ixy="0.0000153"
    ixz="0.0000148"
    iyy="0.0023675"
    iyz="0.0004558"
    izz="0.0023618"/>
  <joint name="right_hip_pitch" type="revolute">
    <parent link="base_link"/>
    <child link="right_hip_pitch_link"/>
    <origin xyz="0 -0.083263 -0.12144" rpy="0 0 0"/>
    <axis xyz="0 -0.70711 -0.70711"/>
    <limit lower="-1.175" upper="2.84" effort="140.0" velocity="5.0"/>
  </joint>

  <xacro:mesh_link
    name="right_hip_roll_link"
    mesh="right_hip_roll_link.STL"
    mass="0.4695347"
    com_xyz="0.0087332 -0.0000069 -0.052579"
    ixx="0.0010247"
    ixy="0"
    ixz="-0.0001714"
    iyy="0.0010028"
    iyz="-0.0000001"
    izz="0.0003931"/>
  <joint name="right_hip_roll" type="revolute">
    <parent link="right_hip_pitch_link"/>
    <child link="right_hip_roll_link"/>
    <origin xyz="0.02 -0.060812 -0.06081" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-2.506" upper="1.043" effort="100.0" velocity="4.0"/>
  </joint>

  <xacro:mesh_link
    name="right_hip_yaw_link"
    mesh="right_hip_yaw_link.STL"
    mass="4.8951529"
    com_xyz="-0.0000385 -0.0106489 -0.1642971"
    ixx="0.0057824"
    ixy="-0.0000083"
    ixz="-0.000007"
    iyy="0.0097895"
    iyz="0.0001901"
    izz="0.0088615"/>
  <joint name="right_hip_yaw" type="revolute">
    <parent link="right_hip_roll_link"/>
    <child link="right_hip_yaw_link"/>
    <origin xyz="-0.008 0 -0.104" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-1.50" upper="1.50" effort="80.0" velocity="4.0"/>
  </joint>

  <xacro:mesh_link
    name="right_knee_link"
    mesh="right_knee_link.STL"
    mass="2.1310136"
    com_xyz="0.0022851 -0.0042143 -0.1581595"
    ixx="0.0086276"
    ixy="-0.0000292"
    ixz="-0.0000626"
    iyy="0.0085109"
    iyz="-0.001453"
    izz="0.0014881"/>
  <joint name="right_knee" type="revolute">
    <parent link="right_hip_yaw_link"/>
    <child link="right_knee_link"/>
    <origin xyz="0 0.0062 -0.30201" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0056" upper="1.9842" effort="140.0" velocity="5.0"/>
  </joint>

  <xacro:mesh_link
    name="right_ankle_pitch_link"
    mesh="right_ankle_pitch_link.STL"
    mass="0.0365367"
    com_xyz="0.0000001 0.0257 0.0000001"
    ixx="0.0000058"
    ixy="0"
    ixz="0"
    iyy="0.0000043"
    iyz="0"
    izz="0.0000088"/>
  <joint name="right_ankle_pitch" type="revolute">
