<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="jljwholebody">
  <xacro:arg name="use_mock_hardware" default="true"/>
  <xacro:arg name="hardware_plugin" default="jljwholebody_hardware/JljWholebodySystem"/>
  <xacro:arg name="motor_config_path" default=""/>
  <xacro:arg name="parallel_mechanisms_path" default=""/>
  <xacro:arg name="enable_on_activate" default="false"/>
  <xacro:arg name="disable_on_deactivate" default="true"/>
  <xacro:arg name="command_timeout_ms" default="0"/>
  <xacro:arg name="feedback_poll_timeout_ms" default="0"/>
  <xacro:arg name="lifecycle_timeout_ms" default="500"/>
  <xacro:arg name="startup_feedback_warmup_s" default="0.5"/>
  <xacro:arg name="enable_retries" default="3"/>
  <xacro:arg name="enable_retry_interval_ms" default="200"/>

  <xacro:property
    name="mesh_dir"
    value="package://jljwholebody_description/meshes/lowbody"/>

  <material name="jlj_silver">
    <color rgba="0.898 0.9176 0.9294 1.0"/>
  </material>

  <xacro:macro
    name="mesh_link"
    params="name mesh mass com_xyz ixx ixy ixz iyy iyz izz">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_dir}/${mesh}"/>
        </geometry>
        <material name="jlj_silver"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_dir}/${mesh}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="${com_xyz}" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia
          ixx="${ixx}"
          ixy="${ixy}"
          ixz="${ixz}"
          iyy="${iyy}"
          iyz="${iyz}"
          izz="${izz}"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:macro name="controlled_joint" params="name lower upper motor_name">
    <joint name="${name}">
      <param name="motor_name">${motor_name}</param>
      <command_interface name="position">
        <param name="min">${lower}</param>
        <param name="max">${upper}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="simple_mesh_link" params="name mesh mass:=0.1">
    <link name="${name}">
      <visual>
        <geometry><mesh filename="${mesh_dir}/${mesh}"/></geometry>
        <material name="jlj_silver"/>
      </visual>
      <collision>
        <geometry><mesh filename="${mesh_dir}/${mesh}"/></geometry>
      </collision>
      <inertial>
        <mass value="${mass}"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- Lower-body geometry is retained from the validated deployment model;
       upper-body geometry and joints below mirror the whole-body MJCF task. -->
  <xacro:mesh_link
    name="base_link"
    mesh="base_link.STL"
    mass="6.4215738"
    com_xyz="-0.0009132 0.000016 -0.0779084"
    ixx="0.0186218"
    ixy="-0.0000004"
    ixz="-0.0000523"
    iyy="0.0112883"
    iyz="-0.0000001"
    izz="0.0157697"/>

  <xacro:mesh_link
    name="waist_yaw_link"
    mesh="waist_yaw_link.STL"
    mass="0.9641464"
    com_xyz="-0.0259888 0 0.0360763"
    ixx="0.0005716"
    ixy="0"
    ixz="0.0000066"
    iyy="0.0006786"
    iyz="0"
    izz="0.001122"/>
  <joint name="waist_yaw" type="revolute">
    <parent link="base_link"/>
    <child link="waist_yaw_link"/>
    <origin xyz="0 0 0.007" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="80.0" velocity="4.0"/>
  </joint>

  <xacro:mesh_link
    name="waist_roll_link"
    mesh="waist_roll_link.STL"
    mass="0.0365367"
    com_xyz="0.0269999 0 -0.0000001"
    ixx="0.0000058"
    ixy="0"
    ixz="0"
    iyy="0.0000043"
    iyz="0"
    izz="0.0000088"/>
  <joint name="waist_roll" type="revolute">
    <parent link="waist_yaw_link"/>
    <child link="waist_roll_link"/>
    <origin xyz="-0.027 0 0.062" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.2" upper="0.2" effort="80.0" velocity="4.0"/>
  </joint>

  <xacro:mesh_link
    name="waist_pitch_link"
    mesh="waist_pitch.STL"
    mass="10.8803064"
    com_xyz="-0.0005949 0.2159513 -0.0195872"
    ixx="0.22480921"
    ixy="-0.00238925"
    ixz="0.00003041"
    iyy="0.0702677"
    iyz="0.00043961"
    izz="0.18860673"/>
  <joint name="waist_pitch" type="revolute">
    <parent link="waist_roll_link"/>
    <child link="waist_pitch_link"/>
    <origin xyz="-0.02 0 0.017" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.5" upper="0.5" effort="80.0" velocity="4.0"/>
  </joint>

  <link name="imu_link"/>
  <joint name="base_to_imu" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.01 0 -0.09" rpy="0 0 0"/>
  </joint>

  <xacro:mesh_link
    name="left_hip_pitch_link"
    mesh="left_hip_pitch_link.STL"
    mass="2.0704946"
    com_xyz="0.0035805 0.0540167 -0.053752"
    ixx="0.003699"
    ixy="-0.0000151"
    ixz="0.0000149"
    iyy="0.0023631"
    iyz="-0.0004567"
    izz="0.0023682"/>
  <joint name="left_hip_pitch" type="revolute">
    <parent link="base_link"/>
    <child link="left_hip_pitch_link"/>
    <origin xyz="0 0.088214 -0.12639" rpy="0 0 0"/>
    <axis xyz="0 0.70711 -0.70711"/>
    <limit lower="-2.384" upper="2.466" effort="140.0" velocity="5.0"/>
  </joint>

  <xacro:mesh_link
    name="left_hip_roll_link"
    mesh="left_hip_roll_link.STL"
    mass="0.4695347"
    com_xyz="0.0017332 -0.0000073 -0.052578"
    ixx="0.0010247"
    ixy="0"
    ixz="-0.0001714"
    iyy="0.0010028"
    iyz="-0.0000001"
    izz="0.0003931"/>
  <joint name="left_hip_roll" type="revolute">
    <parent link="left_hip_pitch_link"/>
    <child link="left_hip_roll_link"/>
    <origin xyz="0.027 0.055861 -0.055861" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.165" upper="2.465" effort="100.0" velocity="4.0"/>
  </joint>

  <xacro:mesh_link
    name="left_hip_yaw_link"
    mesh="left_hip_yaw_link.STL"
    mass="4.8993124"
    com_xyz="0.0000384 0.0106394 -0.1631784"
    ixx="0.0057826"
    ixy="-0.0000083"
    ixz="0.000007"
    iyy="0.0097895"
    iyz="-0.0001901"
    izz="0.0088616"/>
  <joint name="left_hip_yaw" type="revolute">
