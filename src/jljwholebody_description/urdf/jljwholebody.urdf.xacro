    <child link="right_ankle_pitch_link"/>
    <origin xyz="0.0030006 -0.0419 -0.42596" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.5" upper="0.3" effort="80.0" velocity="4.0"/>
  </joint>

  <xacro:mesh_link
    name="right_ankle_roll_link"
    mesh="right_ankle_roll_link.STL"
    mass="0.6758881"
    com_xyz="-0.01299 -0.0000665 -0.0250404"
    ixx="0.0002437"
    ixy="-0.0000064"
    ixz="-0.0000021"
    iyy="0.0021644"
    iyz="0"
    izz="0.0023471"/>
  <joint name="right_ankle_roll" type="revolute">
    <parent link="right_ankle_pitch_link"/>
    <child link="right_ankle_roll_link"/>
    <origin xyz="0.024 0.0257 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.2" upper="0.2" effort="80.0" velocity="4.0"/>
  </joint>

  <!-- Upper body follows the whole-body training joint names and order. -->
  <xacro:simple_mesh_link name="left_shoulder_pitch_link" mesh="left_shoulder_pitch.STL" mass="0.46"/>
  <joint name="left_shoulder_pitch" type="revolute">
    <parent link="waist_pitch_link"/>
    <child link="left_shoulder_pitch_link"/>
    <origin xyz="0 0.345 0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.42" upper="1.46" effort="54.0" velocity="8.0"/>
  </joint>
  <xacro:simple_mesh_link name="left_shoulder_roll_link" mesh="left_shoulder_roll.STL" mass="0.21"/>
  <joint name="left_shoulder_roll" type="revolute">
    <parent link="left_shoulder_pitch_link"/>
    <child link="left_shoulder_roll_link"/>
    <origin xyz="0 -0.029 0.06" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.14" upper="0.16" effort="54.0" velocity="8.0"/>
  </joint>
  <xacro:simple_mesh_link name="left_shoulder_yaw_link" mesh="left_shoulder_yaw.STL" mass="0.23"/>
  <joint name="left_shoulder_yaw" type="revolute">
    <parent link="left_shoulder_roll_link"/>
    <child link="left_shoulder_yaw_link"/>
    <origin xyz="0 0.066 -0.03" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.669" upper="1.499" effort="28.0" velocity="8.0"/>
  </joint>
  <xacro:simple_mesh_link name="left_elbow_link" mesh="left_elbow.STL" mass="0.18"/>
  <joint name="left_elbow" type="revolute">
    <parent link="left_shoulder_yaw_link"/>
    <child link="left_elbow_link"/>
    <origin xyz="0.031 0 -0.154" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.44" upper="0.99" effort="28.0" velocity="10.0"/>
  </joint>
  <xacro:simple_mesh_link name="left_wrist_yaw_link" mesh="left_wrist_yaw.STL" mass="0.18"/>
  <joint name="left_wrist_yaw" type="revolute">
    <parent link="left_elbow_link"/>
    <child link="left_wrist_yaw_link"/>
    <origin xyz="0.022 0.093 -0.032" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.453" upper="1.691" effort="10.0" velocity="12.0"/>
  </joint>
  <xacro:simple_mesh_link name="left_wrist_roll_link" mesh="left_wrist_roll.STL" mass="0.13"/>
  <joint name="left_wrist_roll" type="revolute">
    <parent link="left_wrist_yaw_link"/>
    <child link="left_wrist_roll_link"/>
    <origin xyz="-0.017 0.029 0.121" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.739" upper="1.404" effort="10.0" velocity="12.0"/>
  </joint>
  <xacro:simple_mesh_link name="left_wrist_pitch_link" mesh="left_wrist_pitch.STL" mass="0.16"/>
  <joint name="left_wrist_pitch" type="revolute">
    <parent link="left_wrist_roll_link"/>
    <child link="left_wrist_pitch_link"/>
    <origin xyz="0.02 0.005 0.034" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.862" upper="0.709" effort="10.0" velocity="12.0"/>
  </joint>

  <xacro:simple_mesh_link name="right_shoulder_pitch_link" mesh="right_shoulder_pitch.STL" mass="0.46"/>
  <joint name="right_shoulder_pitch" type="revolute">
    <parent link="waist_pitch_link"/>
    <child link="right_shoulder_pitch_link"/>
    <origin xyz="0 -0.345 0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.374" upper="3.488" effort="54.0" velocity="8.0"/>
  </joint>
  <xacro:simple_mesh_link name="right_shoulder_roll_link" mesh="right_shoulder_roll.STL" mass="0.21"/>
  <joint name="right_shoulder_roll" type="revolute">
    <parent link="right_shoulder_pitch_link"/>
    <child link="right_shoulder_roll_link"/>
    <origin xyz="0 0.029 0.06" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.223" upper="3.172" effort="54.0" velocity="8.0"/>
  </joint>
  <xacro:simple_mesh_link name="right_shoulder_yaw_link" mesh="right_shoulder_yaw.STL" mass="0.23"/>
  <joint name="right_shoulder_yaw" type="revolute">
    <parent link="right_shoulder_roll_link"/>
    <child link="right_shoulder_yaw_link"/>
    <origin xyz="0 -0.066 -0.03" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.594" upper="1.547" effort="28.0" velocity="8.0"/>
  </joint>
  <xacro:simple_mesh_link name="right_elbow_link" mesh="right_elbow.STL" mass="0.18"/>
  <joint name="right_elbow" type="revolute">
    <parent link="right_shoulder_yaw_link"/>
    <child link="right_elbow_link"/>
    <origin xyz="0.031 0 -0.154" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.542" upper="0.992" effort="28.0" velocity="10.0"/>
  </joint>
  <xacro:simple_mesh_link name="right_wrist_yaw_link" mesh="right_wrist_yaw.STL" mass="0.18"/>
  <joint name="right_wrist_yaw" type="revolute">
    <parent link="right_elbow_link"/>
    <child link="right_wrist_yaw_link"/>
    <origin xyz="-0.018 0.094 -0.032" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.808" upper="1.328" effort="10.0" velocity="12.0"/>
  </joint>
  <xacro:simple_mesh_link name="right_wrist_roll_link" mesh="right_wrist_roll.STL" mass="0.13"/>
  <joint name="right_wrist_roll" type="revolute">
    <parent link="right_wrist_yaw_link"/>
    <child link="right_wrist_roll_link"/>
    <origin xyz="0.025 -0.022 0.121" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.573" upper="1.563" effort="10.0" velocity="12.0"/>
  </joint>
  <xacro:simple_mesh_link name="right_wrist_pitch_link" mesh="right_wrist_pitch.STL" mass="0.16"/>
  <joint name="right_wrist_pitch" type="revolute">
    <parent link="right_wrist_roll_link"/>
    <child link="right_wrist_pitch_link"/>
    <origin xyz="-0.02 0.003 0.034" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.628" upper="0.947" effort="10.0" velocity="12.0"/>
  </joint>

  <ros2_control name="JljWholebodySystem" type="system">
    <hardware>
      <xacro:if value="$(arg use_mock_hardware)">
        <plugin>mock_components/GenericSystem</plugin>
      </xacro:if>
      <xacro:unless value="$(arg use_mock_hardware)">
        <plugin>$(arg hardware_plugin)</plugin>
        <param name="motor_config_path">$(arg motor_config_path)</param>
        <param name="parallel_mechanisms_path">$(arg parallel_mechanisms_path)</param>
        <param name="enable_on_activate">$(arg enable_on_activate)</param>
        <param name="disable_on_deactivate">$(arg disable_on_deactivate)</param>
        <param name="command_timeout_ms">$(arg command_timeout_ms)</param>
        <param name="feedback_poll_timeout_ms">$(arg feedback_poll_timeout_ms)</param>
        <param name="lifecycle_timeout_ms">$(arg lifecycle_timeout_ms)</param>
        <param name="startup_feedback_warmup_s">$(arg startup_feedback_warmup_s)</param>
        <param name="enable_retries">$(arg enable_retries)</param>
        <param name="enable_retry_interval_ms">$(arg enable_retry_interval_ms)</param>
      </xacro:unless>
    </hardware>

    <xacro:controlled_joint name="left_hip_yaw" lower="-1.50" upper="1.50" motor_name="left_hip_yaw"/>
    <xacro:controlled_joint name="left_hip_roll" lower="-1.165" upper="2.465" motor_name="left_hip_roll"/>
    <xacro:controlled_joint name="left_hip_pitch" lower="-2.384" upper="2.466" motor_name="left_hip_pitch"/>
